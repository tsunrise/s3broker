{
	"name": "s3broker-worker",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "npm run build --workspace=s3broker",
		"test": "npm run build && vitest run",
		"fmt": "prettier --write .",
		"fmt:check": "prettier --check .",
		"lint": "npm run fmt:check && eslint .",
		"lint:fix": "prettier --write . && eslint . --fix",
		"typecheck": "tsc --noEmit",
		"rotate-client-key": "./scripts/rotate-client-key.sh"
	},
	"dependencies": {
		"s3broker": "workspace:*",
		"aws4fetch": "^1.0.20",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.8.19",
		"@eslint/js": "^9.17.0",
		"eslint": "^9.17.0",
		"pre-commit": "^1.2.2",
		"prettier": "^3.4.2",
		"typescript": "^5.5.2",
		"typescript-eslint": "^8.19.0",
		"vitest": "~3.2.0",
		"wrangler": "^4.54.0"
	},
	"pre-commit": [
		"lint",
		"typecheck"
	]
}
