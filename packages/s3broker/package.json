{
	"name": "s3broker",
	"version": "0.6.2",
	"description": "S3 proxy library with SigV4 verification and configurable guardrails policies",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./sigv4": {
			"types": "./dist/sigv4.d.mts",
			"import": "./dist/sigv4.mjs",
			"require": "./dist/sigv4.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run build"
	},
	"keywords": [
		"s3",
		"proxy",
		"sigv4",
		"aws",
		"guardrails",
		"security",
		"cloudflare-workers"
	],
	"license": "MIT",
	"dependencies": {
		"aws4fetch": "^1.0.20",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.1.1",
		"tsdown": "^0.11.8",
		"typescript": "^5.5.2"
	},
	"author": "Tom Shen",
	"repository": {
		"type": "git",
		"url": "https://github.com/tsunrise/s3broker"
	}
}
